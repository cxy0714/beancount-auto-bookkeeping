option "operating_currency" "CNY"

; 演示账本账户表（普通虚拟账户）
; 所有账户均为示例，不对应任何真实用户。

; 账户命名说明:
; Checking = 活期账户, 日常消费/转账/取现
; Savings = 储蓄/理财账户, 银行备用金或平台理财
; Balance = 支付平台钱包余额
; Foreign = 外币账户
; 支付平台为什么有两个: 原系统把平台余额和平台理财分开记账
; Balance 从余额扣款, Savings 从理财余额扣款

2019-01-21 commodity FUND999999
  name: "示例基金"

2019-01-21 open Assets:Cash:Alipay:YuE  ; 支付宝余额
2019-01-21 open Assets:Cash:Alipay:YuEBao  ; 支付宝理财（余额宝类）
2019-01-21 open Assets:Cash:Bank:BankA:Checking  ; 示例银行A 活期账户
2019-01-21 open Assets:Cash:Bank:BankA:EUR  ; 示例银行A 欧元账户
2019-01-21 open Assets:Cash:Bank:BankA:Foreign  ; 示例银行A 外币父级（勿直接记账）
2019-01-21 open Assets:Cash:Bank:BankA:Foreign:EUR  ; 示例银行A 外币-欧元
2019-01-21 open Assets:Cash:Bank:BankA:Foreign:USD  ; 示例银行A 外币-美元
2019-01-21 open Assets:Cash:Bank:BankA:Savings  ; 示例银行A 储蓄/备用金
2019-01-21 open Assets:Cash:Bank:BankA:USD  ; 示例银行A 美元账户
2019-01-21 open Assets:Cash:Bank:BankB:Checking  ; 示例银行B 活期账户
